{
  "name": "dual-chat",
  "productName": "Dual Chat",
  "version": "1.0.0",
  "description": "Twitch ve Kick chat'ini tek pencerede yan yana açan masaüstü uygulaması",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --publish never",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dualchat.app",
    "productName": "Dual Chat",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DualChat-Setup.${ext}"
    },
    "portable": {
      "artifactName": "DualChat-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Hasantunaozdmr/Canzade-ToastyStat/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
