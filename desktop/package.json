{
  "name": "penguchat",
  "productName": "PenguChat",
  "version": "1.0.0",
  "description": "PenguChat: Twitch ve Kick chat'ini tek pencerede açan masaüstü uygulaması",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dualchat.app",
    "productName": "PenguChat",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PenguChat-Setup.${ext}",
      "shortcutName": "PenguChat"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Hasantunaozdmr/PenguChat/releases/latest/download"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
